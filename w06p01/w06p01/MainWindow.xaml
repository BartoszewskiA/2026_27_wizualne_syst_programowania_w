<Window x:Class="w06p01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:w06p01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>



        <WrapPanel
            Grid.Column="0" 
            Grid.Row="0"
            Grid.ColumnSpan="12"
            Grid.RowSpan="2"
            Background="Aqua"
            Margin="10">
            <Button Content="Button 1" Width="100" Height="30" Margin="5"/>
            <Button Content="Button 2" Width="100" Height="30" Margin="5"/>
            <Button Content="Button 1" Width="100" Height="30" Margin="5"/>
            <Button Content="Button 2" Width="100" Height="30" Margin="5"/>
        </WrapPanel>
        
        <Rectangle 
            Grid.Column="0" 
            Grid.Row="10"
            Grid.ColumnSpan="12"
            Grid.RowSpan="2"
            Fill="Aqua"
            Margin="10"
        />
        <Rectangle 
            Grid.Column="0" 
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Grid.RowSpan="8"
            Fill="DarkCyan"
            Margin="10"
        />
        <Rectangle 
            Grid.Column="10" 
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Grid.RowSpan="8"
            Fill="Goldenrod"
            Margin="10"
        />

        <Rectangle 
            Grid.Column="3" 
            Grid.Row="2"
            Grid.ColumnSpan="7"
            Grid.RowSpan="8"
            Fill="Navy"
            Margin="10"
        />

    </Grid>
</Window>
